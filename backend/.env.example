NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
MONGODB_DATABASE_NAME=vistar_cabs_dev

# Local OTP display is only accepted in development against a separate
# database whose name contains dev, development, test or local.
ADMIN_RECOVERY_LOCAL_CODES=true

# Set strong, unique values in the backend host's private environment.
ADMIN_USERNAME=<owner-username>
ADMIN_PASSWORD=<initial-owner-password>
ADMIN_SESSION_SECRET=<long-random-secret>
SEO_ADMIN_USERNAME=<seo-username>
SEO_ADMIN_PASSWORD=<seo-password>

# Password recovery sends independent OTPs to both owner-controlled channels.
# Production always requires delivery. Keep these credentials private and use
# an owner-controlled account and an SMS sender registered with the provider.
ADMIN_RECOVERY_EMAIL=infovistarcabs@gmail.com
ADMIN_RECOVERY_PHONE=+918767613575
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=infovistarcabs@gmail.com
SMTP_PASSWORD=<google-app-password>
SMTP_FROM=Vistar Cabs Admin <infovistarcabs@gmail.com>
TWILIO_ACCOUNT_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>
TWILIO_FROM_NUMBER=<verified-twilio-sender-number>
